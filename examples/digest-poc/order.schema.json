{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order emitted by the model",
  "type": "object",
  "properties": {
    "item": { "type": "string" },
    "qty": { "type": "number", "minimum": 1, "maximum": 99 },
    "gift_wrap": { "type": "boolean" },
    "size": { "enum": ["small", "double", "triple"] }
  },
  "required": ["item", "qty"]
}
